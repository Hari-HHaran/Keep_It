# Copy this file to .env.local and fill in your Supabase values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Keep demo mode enabled as a presentation fallback.
# The real backend is used automatically whenever a user is authenticated.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
